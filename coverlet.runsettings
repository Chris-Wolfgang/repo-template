<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Comma-separated: coverlet splits these lists on ',' (a ';' list is one pattern that matches nothing).
               Generated sources (*.g.cs) are not hand-written and are excluded. -->
          <ExcludeByFile>**/bin/**/*.cs,**/obj/**/*.cs,**/*.g.cs</ExcludeByFile>
          <!-- Attribute names WITHOUT the "Attribute" suffix; "GeneratedCode" covers source-generator output. -->
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCode</ExcludeByAttribute>
          <!--
            Exclude:
            - AutoGeneratedProgram: the `Main` entry point every test project
              compiles from Microsoft.NET.Test.Sdk's own
              build/<tfm>/Microsoft.NET.Test.Sdk.Program.cs, which lives in the
              NuGet package cache, not in the project's obj/ - so ExcludeByFile
              above does not catch it. SDK-supplied code, never hand-written and
              never called by a test; without this filter it is a 0% class in
              every test assembly.

            Nothing else is excluded by class or namespace. Test models,
            fixtures, fakes and stubs are test code, and every test assembly is
            held to CODECOV_TEST_MINIMUM: a member no test executes is dead test
            code to delete or exercise. The one allowed [ExcludeFromCodeCoverage]
            is on a dedicated infrastructure-detection method (e.g. "is Docker
            available") whose unavailable branch never runs in CI.
          -->
          <Exclude>[*]AutoGeneratedProgram</Exclude>
          <!--
            Instrument the test assembly itself in addition to the source
            assembly. Surfaces dead test helpers, unused fakes and unused
            test-model branches so they can be cleaned up or covered.
            [ExcludeFromCodeCoverage] is reserved for the infrastructure-detection
            case described above.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
